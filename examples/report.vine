# A report over a list of records. This is what shaping data in Vine looks
# like: no loops, no mutation, just values flowing through functions.

let orders = [
  {region: "north", item: "bolt",    qty: 12, unit: 0.25},
  {region: "south", item: "nut",     qty: 40, unit: 0.5},
  {region: "north", item: "washer",  qty: 8,  unit: 0.75},
  {region: "east",  item: "bolt",    qty: 20, unit: 0.25},
  {region: "south", item: "bracket", qty: 3,  unit: 2.0},
  {region: "north", item: "nut",     qty: 10, unit: 0.5},
]

let total = fn(order) { order.qty * order.unit }

# Grouping is a fold that builds a map one key at a time.
let by_region = reduce(orders, fn(acc, order) {
  set(acc, order.region, get(acc, order.region, 0.0) + total(order))
}, {})

# These are amounts of money, so they are written to two decimal places
# rather than however few digits the float needs: `fixed`, not `str`.
let line = fn(region) { "{region}: {fixed(by_region[region], 2)}" }

print("revenue by region")
print(keys(by_region) |> sort |> map(line) |> join("\n"))

# Ranking records needs a key function: sort(xs) orders scalars, and these are
# records. Descending is a negated key. sort is stable, so the two orders tied
# at 6.00 come out in the order they were written.
let ranked = sort(orders, fn(order) { -total(order) })
let rank_line = fn(order) {
  "  {order.item} in {order.region}: {fixed(total(order), 2)}"
}

# take(xs, n) answers what is there when there is less: three of six here,
# and all two of a two-order day rather than an index past the end.
print("largest three orders")
print(ranked |> take(3) |> map(rank_line) |> join("\n"))
print("orders over 5.0: {len(filter(orders, fn(o) { total(o) > 5.0 }))}")

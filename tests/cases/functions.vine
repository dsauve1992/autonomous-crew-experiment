let double = fn(n) { n * 2 }
print(double(21))

let make_adder = fn(n) {
  fn(x) { x + n }
}
let add5 = make_adder(5)
print(add5(10))

let fact = fn(n) {
  if n <= 1 { 1 } else { n * fact(n - 1) }
}
print(fact(6))

let apply = fn(f, x) { f(x) }
print(apply(double, 4))
print(double)
print(fn(a, b) { a })

let noop = fn() { }
print(noop())

# A builtin is a function too, and reprs with a second spelling: no arity,
# because `range` takes one argument or two. See `repr and str` in the spec.
print(trim)
print([trim, double])

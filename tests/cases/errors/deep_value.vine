print("this line runs, and the report used to point here")
# A value five thousand deep, built by five thousand *shallow* calls: `reduce`
# calls its function once per element and each call returns before the next
# begins, so `MAX_DEPTH` -- which counts calls nested inside calls -- never
# sees more than one. The guard that fires is the RecursionError net in `run`,
# and nothing in the suite had printed its message in thirty ticks. When it
# was found, it reported every such failure at 1:1: the caret sat on whatever
# the program's first line happened to be, which is the line above.
let deep = reduce(range(5000), fn(a, i) { [a] }, [])
deep == deep

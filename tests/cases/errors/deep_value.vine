print("this line runs, and the value below is built before anything reads it")
# A value 1001 deep, built by 1001 *shallow* calls: `reduce` calls its
# function once per element and each call returns before the next begins, so
# `MAX_DEPTH` -- which counts calls nested inside calls -- never sees more
# than one. What fires is `MAX_VALUE_DEPTH`, and it fires at the `==` rather
# than at the construction: building the value is not the error, and the line
# above proves the program was still running.
#
# The help carries the number. Until tick 33 there was none to carry: the
# limit was CPython's stack, so this same program failed at a different depth
# depending on how deep the calls around it were and how much stack the
# machine gave the process.
let deep = reduce(range(1000), fn(a, i) { [a] }, [])
deep == deep

let xs = [1, 2, 3, 4]
print(xs)
print(len(xs))
print(xs[0], xs[-1])
print(first(xs))
print(rest(xs))
print(push(xs, 5))
print(xs)
print(concat([1], [2, 3]))
print([1] + [2])
print(range(3))
print(range(2, 5))
print(sort([3, 1, 2]))
print(reverse(xs))
print(contains(xs, 3))
print([1, [2, "three"], nil])
print([])

# One line per boundary in the operator table in docs/spec.md, loosest first.
# Each line is chosen so that regrouping it prints something else, or fails --
# a line that gives the same answer under either grouping proves nothing.

# |> is looser than or, so the whole `1 or 2` is what gets piped.
print(type(1 or 2 |> str))
# or is looser than and.
print(true or false and false)
# and is looser than ==.
print(2 == 2 and 3)
# == is looser than <. Grouped the other way this would compare int with bool.
print(1 < 2 == true)
# < is looser than +. Grouped the other way this would add a bool to an int.
print(1 + 1 < 3)
# + is looser than *.
print(2 + 3 * 4)
# * is looser than unary -, so this is (-2) + 3 and not -(2 + 3).
print(-2 + 3)
# not binds tighter than ==, which is why this is false rather than true.
print(not 1 == true)
# Call, index and member bind tightest: this negates the element it found, and
# does not try to negate the list.
print(-[1, 2][1])

# Left-associativity, on lines where the other grouping is still a number.
print(10 - 3 - 2)
print(16 / 4 / 2)
print(100 |> range |> len)

# `/` always produces a float, even when it divides exactly.
print(4 / 2, type(4 / 2))

# `x.k` is exactly `x["k"]`.
let m = {k: "same"}
print(m.k == m["k"])

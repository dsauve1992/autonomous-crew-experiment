# str shows a value to a person; repr is Vine source for it. They differ
# exactly where quoting does -- and a container reprs its elements whichever
# was asked of the container, which is why str of a list has quotes in it.
print(str(42), str(2.5), str(true), str(nil))
print(str([1, "a"]), str({a: nil}))
print(str("plain"), repr("plain"))
print(repr("a\"b"), repr(42), repr(nil), repr(["x"]))

# int truncates towards zero and accepts surrounding space in a string.
print(int("17"), int("  17  "), int(2.9), int(-2.9), int(true), int(false))
print(float("1.5"), float(3), float(2.5))
print(type(int(2.9)), type(float(3)))

# What `int` and `float` read out of a string is Vine's alphabet and Python's
# shape. The sign is allowed because data has signs in it; `.5` and `1.` are
# allowed though neither is a literal a program may write, because in a string
# there is no member operator for the `.` to be. See **Conversions**.
# The space a number may sit in is four characters, and the help names all
# four. A carriage return is one of them because data arrives with CRLF line
# endings in it; it is the one the rule left unnamed until tick 47.
print(int("+5"), int("-5"), int("\t17\n"), int("\r17\r"), float(" \r2.5\n "))
print(float(".5"), float("1."), float("+1e3"), float("-2.5"))

# A default answers where the text is not a number, and nowhere else. It is
# the one-argument form with its failure answered rather than a second reading
# of the grammar, so the two forms cannot disagree about what a number is --
# which a hand-written predicate already did, on "1e5". See **When the text is
# not a number**.
print(int("17", 0), int("abc", 0), int("", 0), int("2.5", nil))
print(float("2.5", nil), float("abc", nil), float("1e400", nil),
      float("\u{661}\u{662}\u{663}", nil))

# A default never changes an answer that exists, and is a value of any type.
print(int(2.9, 99), int(true, 99), float(3, 99.0), int("x", "none"))

# The predicate this language does not have as a builtin, because this is it:
# one line, the same reading of the grammar, and a value that pipes.
let is_number = fn(s) { float(s, nil) != nil }
print(filter(["1", "x", "1e5", "1.", "1_0", " 2 "], is_number))

# Every claim in **Text**, run. The two spellings of é are written side
# by side, because a reader cannot see which is which and that is the point:
# the same text, two strings, and Vine answering about the string.
#
# Several literals below hold characters that cannot be typed in Vine at all
# -- the escapes stop at \n \t \r \" \\ \{ and \} -- so a non-breaking
# space and a record separator are pasted in, invisible here and in any diff.
# Every line answers a count or a boolean, so the golden beside this file
# holds none of them and an edit that loses one fails rather than matching.
let composed = "é"
let decomposed = "é"
print(len(composed), len(decomposed), composed == decomposed)
print(repr(decomposed[0]), len(decomposed[0]))
print(contains(decomposed, composed), contains(composed, "e"), contains(decomposed, "e"))
print(len(split(decomposed, "")))
print(reverse("née"), reverse("née"))
print(len(keys({} |> set(composed, 1) |> set(decomposed, 2))))

# Case conversion changes the length and does not undo itself.
print(upper("straße"), len("straße"), len(upper("straße")))
print(upper("ﬁ"), lower(upper("straße")))
print(len("İ"), len(lower("İ")))

# trim removes what Unicode calls whitespace, which is wider than the four
# characters a program may have: a non-breaking space and a record separator
# both go.
print(len(trim("\u{a0}x\u{a0}")), len(trim("\u{1e}x")), len(trim(" \t x \n ")))

# repr writes a character nobody can see as a codepoint escape, so its
# output is source a reader can type and not only paste, and it still reads
# back equal. See **repr and str**.
let rs = "a\u{1e}b"
print(len(rs), rs == "a\u{1e}b", repr(rs) == "\"a\\u\{1e}b\"")

# The one pasted record separator left in this file, and its whole job is to
# say that \u{1e} is that character and not another one. Do not tidy it into
# an escape: if an edit drops it this answers false and the golden fails,
# which is why it is written as a boolean.
print(rs == "ab", len("ab"))

# The narrow trim named beside the claim above: trimming the record eats its
# outer delimiters and the field count goes with them, so trim the fields.
let row = " a b "
print(len(split(row, " ")), len(split(trim(row), " ")))
print(repr(map(split(row, " "), trim)))

# split and join are a pair: one more piece than there are separators, so the
# empty string splits to one empty piece and joins back to itself. With an
# empty separator there is nothing to count and the pieces are the codepoints.
print(repr(split("", ",")), repr(split("aa", "a")), repr(split("", "")))
print(join(split("a,,b", ","), ",") == "a,,b", repr(join([], ",")))

# replace composes: join(split(s, from), to). Written wrong it answers rather
# than failing, which is the price **Why there is no replace** names.
print(repr(join(split("a,b", ","), ";")), repr(join(split("a,b", ";"), ",")))
print(repr(join(split(",", "a,b"), ";")))
print(repr(join(split("abc", ""), "-")), repr(join(split("", ""), "-")))

# contains is three builtins under one name: substring, element, key.
print(contains("abc", ""), contains([1], [1]), contains([[1]], [1]))
print(contains({a: 1}, "a"), contains({a: 1}, "z"))
